<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.FullHistoryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 16 12 16;">
            <Button text="← Back" onAction="#onBack"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14 8 14;" />
            <Label text="Complete History"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-background-color: #f0f2f5;">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32" />
            </padding>

            <Label text="All-Time Sales Records"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="200"
                                 style="-fx-font-weight: bold;" />
                    <TableColumn fx:id="revenueCol" text="Total Revenue" prefWidth="220" />
                    <TableColumn fx:id="ordersCol" text="Orders" prefWidth="140" />
                </columns>
                <placeholder>
                    <Label text="No records yet." style="-fx-text-fill: #95a5a6;" />
                </placeholder>
            </TableView>

            <Label fx:id="statusLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #e74c3c;" />

        </VBox>
    </center>

</BorderPane>
