<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.DailyHistoryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 16 12 16;">
            <Button text="← Back" onAction="#onBack"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14 8 14;" />
            <Label text="Daily Summary"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="28"
              style="-fx-background-color: #f0f2f5;">
            <padding>
                <Insets top="50" right="60" bottom="50" left="60" />
            </padding>

            <Label fx:id="dateLabel" text=""
                   style="-fx-font-size: 15px; -fx-text-fill: #7f8c8d;" />

            <!-- Stat cards -->
            <HBox spacing="32" alignment="CENTER">

                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dde1e7; -fx-border-radius: 12; -fx-border-width: 1;">
                    <padding>
                        <Insets top="32" right="48" bottom="32" left="48" />
                    </padding>
                    <Label text="TOTAL REVENUE"
                           style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;" />
                    <Label fx:id="revenueLabel" text=""
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                </VBox>

                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dde1e7; -fx-border-radius: 12; -fx-border-width: 1;">
                    <padding>
                        <Insets top="32" right="48" bottom="32" left="48" />
                    </padding>
                    <Label text="ORDERS COMPLETED"
                           style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;" />
                    <Label fx:id="ordersLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" />
                </VBox>

            </HBox>

            <Label fx:id="statusLabel" text="" wrapText="true" maxWidth="420"
                   style="-fx-font-size: 12px; -fx-text-fill: #e74c3c;" />

            <Button text="View Full History →" onAction="#onFullHistory"
                    style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 12 28 12 28;" />

        </VBox>
    </center>

</BorderPane>
