<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.DailyHistoryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #3d2c1e; -fx-padding: 12 20 12 20;">
            <Button text="← Back" onAction="#onBack"
                    style="-fx-background-color: #5a4030; -fx-text-fill: #e8d5ba;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 7 16 7 16;" />
            <Label text="Daily Summary"
                   style="-fx-text-fill: #f5f0e8; -fx-font-size: 22px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="28"
              style="-fx-background-color: #f5f0e8;">
            <padding>
                <Insets top="50" right="60" bottom="50" left="60" />
            </padding>

            <Label fx:id="dateLabel" text=""
                   style="-fx-font-size: 15px; -fx-text-fill: #9a8470;" />

            <HBox spacing="32" alignment="CENTER">

                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #faf7f2; -fx-background-radius: 12;
                             -fx-border-color: #e0d5c5; -fx-border-radius: 12; -fx-border-width: 1;">
                    <padding>
                        <Insets top="32" right="48" bottom="32" left="48" />
                    </padding>
                    <Label text="TOTAL REVENUE"
                           style="-fx-font-size: 11px; -fx-text-fill: #9a8470; -fx-font-weight: bold;" />
                    <Label fx:id="revenueLabel" text=""
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #6aaa82;" />
                </VBox>

                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #faf7f2; -fx-background-radius: 12;
                             -fx-border-color: #e0d5c5; -fx-border-radius: 12; -fx-border-width: 1;">
                    <padding>
                        <Insets top="32" right="48" bottom="32" left="48" />
                    </padding>
                    <Label text="ORDERS COMPLETED"
                           style="-fx-font-size: 11px; -fx-text-fill: #9a8470; -fx-font-weight: bold;" />
                    <Label fx:id="ordersLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #c8922a;" />
                </VBox>

            </HBox>

            <Label fx:id="statusLabel" text="" wrapText="true" maxWidth="420"
                   style="-fx-font-size: 12px; -fx-text-fill: #a05030;" />

            <Button text="View Full History →" onAction="#onFullHistory"
                    style="-fx-background-color: #5a4030; -fx-text-fill: #e8d5ba; -fx-font-size: 14px;
                           -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 12 28 12 28;" />

        </VBox>
    </center>

</BorderPane>
