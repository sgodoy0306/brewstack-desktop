<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.MainViewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 16 12 16;">

            <!-- Title -->
            <Label text="BrewStack POS"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- XP Section -->
            <VBox alignment="CENTER" spacing="4">
                <Label fx:id="baristaNameLabel" text=""
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ProgressBar fx:id="xpBar" prefWidth="220" prefHeight="10" progress="0.0"
                                 style="-fx-accent: #f39c12;" />
                    <Label fx:id="xpLabel" text=""
                           style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;" />
                </HBox>
                <Label fx:id="levelUpLabel" text="" visible="false"
                       style="-fx-text-fill: #f1c40f; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- History -->
            <Button text="Daily History" onAction="#onDailyHistory"
                    style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14 8 14;" />

            <!-- Barista Switcher -->
            <Button text="Switch Barista" onAction="#onSwitchBarista"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14 8 14;" />

        </HBox>
    </top>

    <center>
        <StackPane>
            <FlowPane fx:id="recipePane" hgap="12" vgap="12"
                      style="-fx-background-color: #f5f5f5;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>
            </FlowPane>

            <!-- Toast notification — floats above the recipe grid -->
            <Label fx:id="toastLabel" text="" visible="false" wrapText="true" maxWidth="500"
                   StackPane.alignment="BOTTOM_CENTER"
                   style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 20 12 20; -fx-font-size: 13px; -fx-font-weight: bold;">
                <StackPane.margin>
                    <Insets bottom="20" />
                </StackPane.margin>
            </Label>
        </StackPane>
    </center>

    <right>
        <VBox spacing="12" prefWidth="260"
              style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16" />
            </padding>
            <Label text="Current Order"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Separator />
            <ListView fx:id="orderListView" prefHeight="400" />
            <Separator />
            <Label fx:id="totalPriceLabel" text="Total:  $0.00"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
            <Button fx:id="completeOrderBtn" text="Complete Order" onAction="#onCompleteOrder"
                    maxWidth="Infinity"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 16 10 16;" />
            <Label fx:id="orderStatusLabel" text="" wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #c0392b;" />
        </VBox>
    </right>

</BorderPane>
