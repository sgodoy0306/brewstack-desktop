<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.MainViewController"
            style="-fx-background-color: #f8f5ff;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18"
              style="-fx-background-color: #1e1830; -fx-padding: 14 20 14 20;">

            <Label text="BrewStack POS"
                   style="-fx-text-fill: #d4bef5; -fx-font-size: 21px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- XP Section -->
            <VBox alignment="CENTER" spacing="4">
                <Label fx:id="baristaNameLabel" text=""
                       style="-fx-text-fill: #ede8f8; -fx-font-size: 13px; -fx-font-weight: bold;" />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ProgressBar fx:id="xpBar" prefWidth="200" prefHeight="14" progress="0.0"
                                 style="-fx-accent: #f5c400; -fx-background-color: #3a2e55; -fx-background-radius: 6;" />
                    <Label fx:id="xpLabel" text=""
                           style="-fx-text-fill: #9b8fc0; -fx-font-size: 11px;" />
                </HBox>
                <Label fx:id="levelUpLabel" text="" visible="false"
                       style="-fx-text-fill: #fbe4a0; -fx-font-size: 11px; -fx-font-weight: bold;" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Stock" onAction="#onStock"
                    style="-fx-background-color: #b5e8d5; -fx-text-fill: #1a4035; -fx-font-size: 12px;
                           -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 7 16 7 16;" />

            <Button text="Daily History" onAction="#onDailyHistory"
                    style="-fx-background-color: #d4bef5; -fx-text-fill: #2e1a6a; -fx-font-size: 12px;
                           -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 7 16 7 16;" />

            <Button text="Switch Barista" onAction="#onSwitchBarista"
                    style="-fx-background-color: #f5c8b0; -fx-text-fill: #6a2a1a; -fx-font-size: 12px;
                           -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 7 16 7 16;" />

        </HBox>
    </top>

    <center>
        <StackPane>
            <FlowPane fx:id="recipePane" hgap="16" vgap="16"
                      style="-fx-background-color: #f8f5ff;">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24" />
                </padding>
            </FlowPane>

            <Label fx:id="toastLabel" text="" visible="false" wrapText="true" maxWidth="460"
                   StackPane.alignment="BOTTOM_CENTER"
                   style="-fx-background-color: #e8a0a0; -fx-text-fill: #4a1a1a;
                          -fx-background-radius: 20; -fx-padding: 12 24 12 24;
                          -fx-font-size: 13px; -fx-font-weight: bold;">
                <StackPane.margin>
                    <Insets bottom="20" />
                </StackPane.margin>
            </Label>
        </StackPane>
    </center>

    <right>
        <VBox spacing="12" prefWidth="265"
              style="-fx-background-color: #ffffff; -fx-border-color: #ece6fa; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="20" right="18" bottom="18" left="18" />
            </padding>

            <Label text="Current Order"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e1830;" />

            <Separator style="-fx-background-color: #ece6fa;" />

            <ListView fx:id="orderListView" prefHeight="400"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;" />

            <Separator style="-fx-background-color: #ece6fa;" />

            <Label fx:id="totalPriceLabel" text="Total:  $0.00"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #5a4a7a;" />

            <Button fx:id="completeOrderBtn" text="Complete Order" onAction="#onCompleteOrder"
                    maxWidth="Infinity"
                    style="-fx-background-color: #b5e8d5; -fx-text-fill: #1a4035;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 11 16 11 16;" />

            <Label fx:id="orderStatusLabel" text="" wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #c0392b;" />
        </VBox>
    </right>

</BorderPane>
