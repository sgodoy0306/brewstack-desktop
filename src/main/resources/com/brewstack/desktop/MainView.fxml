<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.MainViewController">

    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 16;">
            <Label text="BrewStack POS"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>
            <Label text="Welcome to BrewStack POS"
                   style="-fx-font-size: 18px; -fx-text-fill: #555;" />
        </VBox>
    </center>

</BorderPane>
