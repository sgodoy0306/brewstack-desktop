<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.MainViewController">

    <!-- Top: App header with barista selector -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 16 12 16;">
            <Label text="BrewStack POS"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Barista:"
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;" />
            <ComboBox fx:id="baristaComboBox" promptText="Select barista..."
                      prefWidth="200"
                      style="-fx-background-color: #3d5166; -fx-text-fill: white;" />
        </HBox>
    </top>

    <!-- Center: Menu buttons (left) + Status bar (right) -->
    <center>
        <HBox spacing="0">

            <!-- Left: Recipe menu -->
            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #f4f4f4; -fx-border-color: transparent;">
                <content>
                    <VBox spacing="16">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20" />
                        </padding>
                        <Label text="Menu"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <FlowPane fx:id="menuPane" hgap="12" vgap="12" prefWrapLength="560" />
                    </VBox>
                </content>
            </ScrollPane>

            <Separator orientation="VERTICAL" />

            <!-- Right: Barista status bar -->
            <VBox prefWidth="220" spacing="12"
                  style="-fx-background-color: #2c3e50;">
                <padding>
                    <Insets top="24" right="20" bottom="24" left="20" />
                </padding>

                <Label text="BARISTA"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10px; -fx-font-weight: bold;" />
                <Label fx:id="baristaNameLabel" text="—"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />

                <Separator style="-fx-background-color: #3d5166;" />

                <Label text="LEVEL"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10px; -fx-font-weight: bold;" />
                <Label fx:id="baristaLevelLabel" text="—"
                       style="-fx-text-fill: #f39c12; -fx-font-size: 28px; -fx-font-weight: bold;" />

                <Separator style="-fx-background-color: #3d5166;" />

                <Label text="XP PROGRESS"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10px; -fx-font-weight: bold;" />
                <ProgressBar fx:id="xpProgressBar" progress="0"
                             prefWidth="180"
                             style="-fx-accent: #27ae60;" />
                <Label fx:id="xpLabel" text="0 / 0 XP"
                       style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;" />
            </VBox>

        </HBox>
    </center>

    <right>
        <VBox spacing="12" prefWidth="260"
              style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16" />
            </padding>
            <Label text="Current Order"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Separator />
            <ListView fx:id="orderListView" prefHeight="400" />
            <Separator />
            <Label fx:id="totalPriceLabel" text="Total:  $0.00"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
            <Button fx:id="completeOrderBtn" text="Complete Order" onAction="#onCompleteOrder"
                    maxWidth="Infinity"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 16 10 16;" />
            <Label fx:id="orderStatusLabel" text="" wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #c0392b;" />
        </VBox>
    </right>

</BorderPane>
