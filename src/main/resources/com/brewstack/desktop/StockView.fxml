<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.StockViewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 16 12 16;">
            <Button text="← Back" onAction="#onBack"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14 8 14;" />
            <Label text="Stock Management"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-background-color: #f0f2f5;">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Inventory"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label fx:id="lowStockCountLabel" text=""
                       style="-fx-font-size: 13px;" />
            </HBox>

            <Separator />

            <!-- Column headers -->
            <HBox style="-fx-background-color: #dde1e7; -fx-padding: 6 14 6 14; -fx-background-radius: 4;">
                <Label text="Ingredient" prefWidth="200"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5d6d7e;" />
                <Label text="Current Stock  /  Threshold" prefWidth="260"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5d6d7e;" />
                <Label text="Add Stock"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5d6d7e;" />
            </HBox>

            <ListView fx:id="stockListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <placeholder>
                    <Label text="No ingredients found." style="-fx-text-fill: #95a5a6;" />
                </placeholder>
            </ListView>

            <Label fx:id="statusLabel" text="" wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #e74c3c;" />
        </VBox>
    </center>

</BorderPane>
