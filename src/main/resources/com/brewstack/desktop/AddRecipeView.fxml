<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.AddRecipeController"
            style="-fx-background-color: #f5f0e8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #3d2c1e; -fx-padding: 12 20 12 20;">
            <Button text="← Back" onAction="#onBack"
                    style="-fx-background-color: #5a4030; -fx-text-fill: #e8d5ba;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 7 16 7 16;" />
            <Label text="Add New Recipe"
                   style="-fx-text-fill: #f5f0e8; -fx-font-size: 22px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #f5f0e8; -fx-border-color: transparent;">
            <content>
                <VBox spacing="20" maxWidth="560">
                    <padding>
                        <Insets top="32" right="60" bottom="32" left="60" />
                    </padding>

                    <!-- Name -->
                    <VBox spacing="6">
                        <Label text="Recipe Name"
                               style="-fx-text-fill: #3d2c1e; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <TextField fx:id="nameField" promptText="e.g. Flat White"
                                   style="-fx-background-color: #faf7f2; -fx-border-color: #e0d5c5;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-font-size: 13px; -fx-padding: 8 12 8 12;" />
                    </VBox>

                    <!-- Price + XP row -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Price ($)"
                                   style="-fx-text-fill: #3d2c1e; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <TextField fx:id="priceField" promptText="e.g. 4.50"
                                       style="-fx-background-color: #faf7f2; -fx-border-color: #e0d5c5;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-font-size: 13px; -fx-padding: 8 12 8 12;" />
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Base XP Reward"
                                   style="-fx-text-fill: #3d2c1e; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <TextField fx:id="xpField" promptText="e.g. 50"
                                       style="-fx-background-color: #faf7f2; -fx-border-color: #e0d5c5;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-font-size: 13px; -fx-padding: 8 12 8 12;" />
                        </VBox>
                    </HBox>

                    <!-- Image URL -->
                    <VBox spacing="6">
                        <Label text="Image URL (optional)"
                               style="-fx-text-fill: #3d2c1e; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <TextField fx:id="imageUrlField" promptText="https://example.com/image.jpg"
                                   style="-fx-background-color: #faf7f2; -fx-border-color: #e0d5c5;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-font-size: 13px; -fx-padding: 8 12 8 12;" />
                    </VBox>

                    <Separator style="-fx-background-color: #e0d5c5;" />

                    <!-- Ingredients checklist -->
                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Ingredients"
                                   style="-fx-text-fill: #3d2c1e; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Button text="↻ Refresh" onAction="#onRefreshIngredients"
                                    style="-fx-background-color: #e8dfd0; -fx-text-fill: #3d2c1e;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 16; -fx-cursor: hand; -fx-padding: 4 12 4 12;" />
                        </HBox>

                        <!-- Column headers -->
                        <HBox spacing="12">
                            <Label text="Select ingredient" HBox.hgrow="ALWAYS"
                                   style="-fx-text-fill: #9a8470; -fx-font-size: 11px;" />
                            <Label text="Quantity" prefWidth="80"
                                   style="-fx-text-fill: #9a8470; -fx-font-size: 11px;" />
                        </HBox>

                        <Label fx:id="ingredientsStatusLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #9a8470;" />

                        <!-- Populated dynamically by controller -->
                        <VBox fx:id="ingredientListBox" spacing="4"
                              style="-fx-background-color: #faf7f2; -fx-border-color: #e0d5c5;
                                     -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-padding: 12 14 12 14;" />
                    </VBox>

                    <Separator style="-fx-background-color: #e0d5c5;" />

                    <!-- Status + submit -->
                    <Label fx:id="statusLabel" text="" wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: #a05030;" />

                    <Button fx:id="saveBtn" text="Save Recipe" onAction="#onSave"
                            maxWidth="Infinity"
                            style="-fx-background-color: #6aaa82; -fx-text-fill: #0f2e1a;
                                   -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 11 0 11 0;" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
