<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brewstack.desktop.AddBaristaController"
            style="-fx-background-color: #f5f0e8;">

    <center>
        <VBox alignment="CENTER" spacing="24">

            <Label text="New Barista"
                   style="-fx-text-fill: #3d2c1e; -fx-font-size: 28px; -fx-font-weight: bold;" />

            <VBox spacing="8" maxWidth="340">
                <Label text="Name"
                       style="-fx-text-fill: #3d2c1e; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="nameField" promptText="e.g. Maria"
                           style="-fx-background-color: #faf7f2; -fx-border-color: #e0d5c5;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-font-size: 15px; -fx-padding: 10 14 10 14;" />
            </VBox>

            <Label fx:id="statusLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #a05030;" />

            <HBox spacing="12" alignment="CENTER">
                <Button text="← Back" onAction="#onBack"
                        style="-fx-background-color: #e0d5c5; -fx-text-fill: #3d2c1e;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 10 24 10 24;" />
                <Button fx:id="saveBtn" text="Create Barista" onAction="#onSave"
                        style="-fx-background-color: #6aaa82; -fx-text-fill: #0f2e1a;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 10 24 10 24;" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
